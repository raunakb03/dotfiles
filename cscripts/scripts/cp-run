#!/usr/bin/env bash

current_dir=$(pwd)

input_file="$current_dir/input.txt"
output_file="$current_dir/output.txt"

file_name="${1:-p1.cpp}"
file_path="$current_dir/$file_name"

g++ -std=c++17 -O2 -Wall -Wno-unused-variable -Wno-unused-but-set-variable -DLOCAL "$file_path" -o prog || exit 1
./prog < "$input_file" > "$output_file"

cat "$output_file"
